{
  "name": "tripplanner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "prebuild": "npm run gpx:stats",
    "gpx:stats": "node scripts/build-gpx-stats.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p functions/tsconfig.json",
    "preview": "vite preview",
    "gpx:sample": "node scripts/generate-sample-gpx.mjs",
    "pages:dev": "wrangler pages dev dist --d1=DB",
    "db:migrate:local": "wrangler d1 migrations apply tripplanner --local",
    "db:migrate:remote": "wrangler d1 migrations apply tripplanner --remote"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "wrangler": "^4.123.0"
  }
}
